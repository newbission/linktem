# Linktem API — 운영(Render) 환경변수 체크리스트
# ⚠️ 이 파일에 실제 값을 넣지 마세요. 값은 Render 대시보드 > linktem-api > Environment 에 입력합니다.
#    (render.yaml 의 generateValue 항목은 Render 가 자동 생성)

APP_ENV=production
# Vercel 운영 도메인 (쉼표 구분, 프리뷰 배포 *.vercel.app 은 코드에서 정규식으로 허용)
CORS_ORIGINS=https://linktem.vercel.app

# 자동 생성 (render.yaml generateValue)
ADMIN_TOKEN=
CLIENT_HASH_SALT=

# Supabase > Project Settings > Database > Connection pooling (Transaction, 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DB_POOL_MAX=5

# Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

STORAGE_BACKEND=r2

# Cloudflare R2 > API 토큰 (Object Read & Write, 버킷 한정)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=linktem
R2_PUBLIC_BASE_URL=https://img.linktem.app

# 선택: YouTube 가 Render IP 를 봇으로 차단할 때
YTDLP_PROXY=
YTDLP_COOKIES_B64=
