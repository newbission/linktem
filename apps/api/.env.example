# ---- 앱 ----
APP_ENV=development
# 쉼표 구분
CORS_ORIGINS=http://localhost:3000,https://linktem.vercel.app
# POST /api/admin/cleanup 보호용 (openssl rand -hex 32)
ADMIN_TOKEN=
# 익명 클라이언트 해시 솔트 (openssl rand -hex 16)
CLIENT_HASH_SALT=

# ---- Supabase PostgreSQL (Connection Pooler, transaction mode 6543) ----
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DB_POOL_MIN=1
DB_POOL_MAX=5

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 응답 속도: 추론 단계(minimal/low/medium/high, 비우면 모델 기본) / 영상 해상도(low/medium/high)
GEMINI_THINKING_LEVEL=low
GEMINI_MEDIA_RESOLUTION=low
GEMINI_TEMPERATURE=0.2
GEMINI_USE_YOUTUBE_URL=true

# ---- yt-dlp ----
MAX_VIDEO_DURATION_SEC=1200
DOWNLOAD_TIMEOUT_SEC=180
YTDLP_PROXY=
# base64 -i cookies.txt
YTDLP_COOKIES_B64=

# ---- 이미지 ----
IMAGE_MAX_SHORT_SIDE=720
IMAGE_WEBP_QUALITY=75
IMAGE_TARGET_MAX_BYTES=51200

# ---- 스틸컷 저장소 ----
# auto: R2 키가 있으면 R2, 없으면 로컬 디스크 / local / r2
STORAGE_BACKEND=auto
# 로컬 저장 위치 (상대 경로는 apps/api 기준). docker compose 에서는 media 볼륨(/app/data/media) 사용
LOCAL_STORAGE_DIR=./data/media
LOCAL_STORAGE_PUBLIC_PATH=/media

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=linktem
R2_PUBLIC_BASE_URL=https://img.linktem.app
IMAGE_SUPERSEDED_GRACE_DAYS=7
IMAGE_TTL_DAYS=90

# ---- 앙상블 / 피드백 ----
ENSEMBLE_MAX_RUNS=5
FEEDBACK_HIDE_THRESHOLD=3

# ---- 레이트 리밋 ----
ANALYZE_RATE_LIMIT_PER_MIN=6
