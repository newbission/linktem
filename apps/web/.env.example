# 비워 두면(권장) 브라우저는 같은 출처 /api 로 호출하고 Next 가 API_PROXY_TARGET 으로 프록시
# (로컬 기본값 http://localhost:8000, Vercel 에서는 Render 주소 입력)
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=http://localhost:8000
# 서비스 공개 주소 (메타데이터/OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 개발자 후원 링크 (Buy Me a Coffee, Toss 등). 비우면 후원 링크를 숨김
NEXT_PUBLIC_DONATION_URL=
# 구글 애드센스 (승인 후 설정). 비어 있으면 정적 플레이스홀더만 노출
NEXT_PUBLIC_ADSENSE_CLIENT=
