{
  "name": "@linktem/types",
  "version": "0.1.0",
  "private": true,
  "description": "Linktem 프론트엔드/백엔드 공통 데이터 계약",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
